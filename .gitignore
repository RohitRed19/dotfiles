# herdr runtime artifacts (regenerated at runtime; never commit)
home/.config/herdr/*.log
home/.config/herdr/session.json
home/.config/herdr/*.sock

# macOS + nix build noise
.DS_Store
result
result-*

# Pi credentials and Home Manager adoption backups stay local
/home/.pi/agent/auth.json
/home/.pi/agent/**/*.backup

# Pi Calm is a runtime toggle; its local state file is never tracked
/home/.pi/agent/calm

# no-mistakes local validation state - never commit in this public repo
.no-mistakes/

# Work-specific Claude skills. They live here so Home Manager keeps them
# symlinked and they survive a ~/.claude rebuild, but they describe internal
# infrastructure and this repo is public - so they are never committed.
/home/.claude/skills/rtb-timeline-query/
/home/.claude/skills/youtrack-flow/
/home/.claude/skills/folio/
/home/.claude/skills/wiki-ingest/
/home/.claude/skills/wiki-retrieve/
/home/.claude/skills/wiki-index/

# Skills that Claude Code syncs from the account at runtime - a cache, not authored.
/home/.claude/skills/synced/

# herdr runtime state.
/home/.config/herdr/release-notes.json
